import mill.*, scalalib.*, scalajslib.*, scalanativelib.*, publish.*, mill.api.BuildCtx.workspaceRoot

trait ScalaCommon extends ScalaModule
{ def scalaVersion = "3.10.0"
}

 object Core extends ScalaCommon
 {
   def platformDeps = Seq(mvn"org.openjfx:javafx-controls:27")
   def jfx = Task { defaultResolver().classpath(platformDeps) }
   def mvnDeps = platformDeps

   def forkArgs = Seq("--module-path",
     sys.env("JAVAFX_HOME") + ":" + "/Users/ajr/Library/Caches/Coursier/v1/https/repo1.maven.org/maven2/org/openjfx/javafx-controls/27",
     "--add-modules", "javafx.controls"
   )
 }

object Serv extends ScalaCommon
{ def scalaVersion = "3.10.0"
  def sources = Task.Sources(workspaceRoot / "Serv" / "src")
  def mvnDeps = Seq(mvn"jakarta.servlet:jakarta.servlet-api:6.1.0", mvn"org.postgresql:postgresql:42.7.14")
}